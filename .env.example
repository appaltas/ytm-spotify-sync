# ---------------------------------------------------------------------------
# YouTube Music - OAuth (RECOMENDADO: no caduca solo, aguanta en CI)
# Genera estos valores con:  python setup_ytm_oauth.py
# ---------------------------------------------------------------------------
YTM_OAUTH_CLIENT_ID="tu_client_id.apps.googleusercontent.com"
YTM_OAUTH_CLIENT_SECRET="tu_client_secret_de_google"
YTM_OAUTH_REFRESH_TOKEN="tu_refresh_token_de_youtube_music"

# Alternativa: token OAuth completo en JSON o ruta a oauth.json
# YTM_OAUTH_JSON='{"access_token": "...", "refresh_token": "...", "scope": "...", "token_type": "Bearer", "expires_at": 0, "expires_in": 0}'

# ---------------------------------------------------------------------------
# YouTube Music - Cookies del navegador (LEGACY, en desuso)
# Solo se usa si no hay credenciales OAuth. Caduca cada pocas semanas.
# ---------------------------------------------------------------------------
# YTM_HEADERS_JSON='{"User-Agent": "...", "Cookie": "...", "Authorization": "..."}'

# ---------------------------------------------------------------------------
# Spotify
# ---------------------------------------------------------------------------
SPOTIPY_CLIENT_ID="tu_spotify_client_id"
SPOTIPY_CLIENT_SECRET="tu_spotify_client_secret"
SPOTIPY_REFRESH_TOKEN="tu_spotify_refresh_token"

# ID de la playlist destino (de https://open.spotify.com/playlist/PLAYLIST_ID)
SPOTIFY_PLAYLIST_ID="tu_spotify_playlist_id"

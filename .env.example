# YouTube Music Headers (Raw JSON string with Cookie, User-Agent, Authorization, etc.)
YTM_HEADERS_JSON='{"User-Agent": "...", "Cookie": "...", "Authorization": "..."}'

# Spotify Developer Application Credentials
SPOTIPY_CLIENT_ID="tu_spotify_client_id"
SPOTIPY_CLIENT_SECRET="tu_spotify_client_secret"
SPOTIPY_REFRESH_TOKEN="tu_spotify_refresh_token"

# Target Spotify Playlist ID (from playlist share link: https://open.spotify.com/playlist/PLAYLIST_ID)
SPOTIFY_PLAYLIST_ID="tu_spotify_playlist_id"
